DEBUG=True
SECRET_KEY=
DATABASE_URL=postgres://user:pass@localhost:5432/stationery_db
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
FRONTEND_URL=http://localhost:5173
DJANGO_SETTINGS_MODULE=config.settings.dev
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Local: from `stripe listen --forward-to localhost:8000/api/payments/stripe/webhook/`
# Production: from Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pkr

# Gmail SMTP (optional). Create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
